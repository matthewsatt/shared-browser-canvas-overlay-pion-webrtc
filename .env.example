# Settings for a public server (e.g. EC2). Copy to .env next to
# docker-compose.yml and fill in; docker compose reads it automatically.
# Then: docker compose up -d --build

# Starts the Caddy HTTPS front end.
COMPOSE_PROFILES=https

# Hostname with a DNS A record pointing at PUBLIC_IP.
DOMAIN=collab.example.com

# The server's public IP (on EC2, an Elastic IP). Viewers' video connects here.
PUBLIC_IP=203.0.113.10

# Required to create a session (your backend sends it). Generate with:
# openssl rand -base64 32
API_TOKEN=

# Your apps' origins, whose pages load sdk.js and connect (comma list).
ALLOWED_ORIGINS=https://app.example.com

# The pages the shared browser may show (comma list of URL prefixes).
ALLOWED_URL_PREFIXES=https://checkin.example.com/,https://visitors.example.com/

# Keep plain HTTP on localhost only; Caddy serves the public HTTPS port.
HTTP_PUBLISH=127.0.0.1:8080
